{
  "name": "@portal/api",
  "private": true,
  "type": "module",
  "exports": {
    "./scheduling": {
      "types": "./dist/schedules/runtime.d.ts",
      "default": "./dist/schedules/runtime.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file=../../.env dist/main.js",
    "db:migrate": "tsx --env-file=../../.env src/database/migrate.ts",
    "admin:create": "tsx --env-file=../../.env src/identity/create-admin.ts"
  },
  "dependencies": {
    "@mikro-orm/core": "7.2.5",
    "@mikro-orm/migrations": "7.2.5",
    "@mikro-orm/postgresql": "7.2.5",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@portal/config": "workspace:*",
    "@portal/contracts": "workspace:*",
    "@portal/form-engine": "workspace:*",
    "@portal/scheduling": "workspace:*",
    "argon2": "0.45.1",
    "ioredis": "5.8.2",
    "minio": "8.0.6",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@mikro-orm/cli": "7.2.5",
    "@types/express": "5.0.6",
    "@types/pg": "8.15.6",
    "tsx": "4.20.6"
  }
}
