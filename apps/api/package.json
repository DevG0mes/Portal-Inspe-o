{
  "name": "@portal/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file=../../.env dist/main.js",
    "db:migrate": "tsx --env-file=../../.env src/database/migrate.ts"
  },
  "dependencies": {
    "@mikro-orm/core": "7.2.5",
    "@mikro-orm/migrations": "7.2.5",
    "@mikro-orm/postgresql": "7.2.5",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@portal/config": "workspace:*",
    "@portal/contracts": "workspace:*",
    "ioredis": "5.8.2",
    "minio": "8.0.6",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@mikro-orm/cli": "7.2.5",
    "@types/pg": "8.15.6",
    "tsx": "4.20.6"
  }
}
