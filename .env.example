# Development only. Copy to .env and replace every password before use.
API_HOST=127.0.0.1
API_PORT=3001
APP_ORIGIN=http://127.0.0.1:3000
# Server-only address used by the web BFF. Never prefix with NEXT_PUBLIC_.
API_INTERNAL_URL=http://127.0.0.1:3001
DATABASE_URL=postgresql://portal:change-me-local@127.0.0.1:5432/portal
POSTGRES_DB=portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=change-me-local
REDIS_URL=redis://127.0.0.1:6379
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=portal-local
MINIO_SECRET_KEY=change-me-local-storage
MINIO_BUCKET=inspection-evidence
