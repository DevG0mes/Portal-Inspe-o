# Copy outside the repository; restrict permissions. Never reuse development credentials.
RELEASE_TAG=REPLACE_WITH_GIT_COMMIT
PORTAL_HOST=portal.internal.example
FILES_HOST=files.internal.example
APP_ORIGIN=https://portal.internal.example
MINIO_PUBLIC_URL=https://files.internal.example
HTTPS_BIND=127.0.0.1
HTTPS_PORT=443
TLS_DIRECTORY=/srv/portal/tls
POSTGRES_DB=portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DATABASE_URL=postgresql://portal:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/portal
MINIO_ACCESS_KEY=REPLACE_WITH_RANDOM_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
MINIO_BUCKET=inspection-evidence
